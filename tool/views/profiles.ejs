<h1>Hồ sơ môi trường</h1>
<p class="sub">Mỗi hồ sơ là một môi trường đích kèm bộ tài khoản theo vai. Chọn hồ sơ lúc chạy — công cụ
<b>không ghi đè file <span class="mono">.env</span></b>, nên hai người dùng hai hồ sơ khác nhau không đụng nhau.</p>

<% if (profiles.length === 0) { %>
  <div class="warn">Chưa có hồ sơ nào. Tạo một hồ sơ trước khi chạy test.</div>
<% } %>

<table>
  <tr><th>Tên</th><th>Base URL</th><th>Vai đã khai</th><th>Còn thiếu</th><th></th></tr>
  <% profiles.forEach((p) => { %>
  <tr>
    <td><a href="/profiles/<%= p.id %>"><%= p.name %></a>
      <% if (p.isProd) { %> <span class="badge b-prod">PROD</span><% } %></td>
    <td class="mono"><%= p.baseUrl %></td>
    <td class="small"><%= p.ready.join(', ') || '—' %></td>
    <td class="small muted"><%= p.missing.join(', ') || '—' %></td>
    <td><a href="/profiles/<%= p.id %>">Sửa</a></td>
  </tr>
  <% }) %>
</table>

<h2>Tạo hồ sơ mới</h2>
<form method="post" action="/profiles" class="card">
  <div class="row" style="margin-bottom:12px">
    <div><label>Tên hồ sơ</label><input name="name" placeholder="UAT pod 1" required></div>
    <div><label>Base URL (web dưới test)</label><input name="baseUrl" placeholder="http://localhost:3000" required></div>
    <div><label>API base URL (bỏ trống = dùng Base URL)</label><input name="apiBaseUrl"></div>
  </div>
  <div class="flex">
    <label style="margin:0"><input type="checkbox" name="isProd" style="width:auto"> Môi trường thật (chặn mặc định case ghi dữ liệu)</label>
    <button class="primary right">Tạo hồ sơ</button>
  </div>
</form>
