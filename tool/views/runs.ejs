<h1>Lịch sử chạy</h1>
<p class="sub">Run gần nhất ở trên cùng.</p>
<table>
  <tr><th>Thời điểm</th><th>Module</th><th>Môi trường</th><th>Phạm vi</th><th>Kết quả</th><th>Người chạy</th><th></th></tr>
  <% runs.forEach((r) => { %>
  <tr>
    <td class="mono small"><%= r.queued_at.replace('T',' ').slice(0,19) %></td>
    <td><%= r.module_name %></td>
    <td><%= r.profile_name %></td>
    <td class="small muted"><%= r.wholeModule ? 'cả module' : r.caseIds.length + ' case' %></td>
    <td>
      <span class="badge <%= r.statusClass %>"><%= r.statusLabel %></span>
      <% if (r.summary && r.summary.total) { %>
        <span class="small muted"><%= r.summary.passed %>/<%= r.summary.total %> (<%= r.summary.passRate %>%)</span>
      <% } %>
    </td>
    <td class="small"><%= r.created_by %></td>
    <td><a href="/runs/<%= r.id %>">log</a> · <a href="/runs/<%= r.id %>/report">báo cáo</a></td>
  </tr>
  <% }) %>
</table>
